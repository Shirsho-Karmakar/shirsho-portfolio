# The public portfolio works without these. Set them to activate the dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
ADMIN_EMAIL=2005shirsho@gmail.com

# Optional: defaults to portfolio-assets, matching supabase/setup.sql.
SUPABASE_STORAGE_BUCKET=portfolio-assets

# Optional: your production URL or custom domain. Vercel's production URL is used automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
